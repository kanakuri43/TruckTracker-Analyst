<mah:MetroWindow x:Class="TruckTrackerAnalyst.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="得意先別 収益分析（粗利 − 配送経費）" Height="680" Width="1200" WindowStartupLocation="CenterScreen"
                 WindowTransitionsEnabled="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ToolTip" Value="{Binding Note}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="LossRow" TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="Crimson" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="期間" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding From}" Width="140" />
            <TextBlock Text="〜" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker SelectedDate="{Binding To}" Width="140" />
            <CheckBox Content="正味回数（1コース内の配達先数で按分）" IsChecked="{Binding NetMode}" Margin="20,0" VerticalAlignment="Center" />
            <Button Content="CSV出力" Command="{Binding ExportCsvCommand}" Width="90" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="Crimson" Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DataGrid Grid.Row="2" Margin="0,10" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  RowStyle="{StaticResource LossRow}" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配送先名" Binding="{Binding Name}" Width="230" />
                <DataGridTextColumn Header="得意先コード" Binding="{Binding Code}" Width="110" />
                <DataGridTextColumn Header="回数" Binding="{Binding Count, StringFormat={}{0:0.##}}" ElementStyle="{StaticResource Right}" Width="70" />
                <DataGridTextColumn Header="期間経費" Binding="{Binding Expense, StringFormat=N0}" ElementStyle="{StaticResource Right}" Width="110" />
                <DataGridTextColumn Header="粗利" Binding="{Binding Profit, StringFormat=N0, TargetNullValue=—}" ElementStyle="{StaticResource Right}" Width="110" />
                <DataGridTextColumn Header="営業利益" Binding="{Binding Net, StringFormat=N0, TargetNullValue=—}" ElementStyle="{StaticResource Right}" Width="110" />
                <DataGridTextColumn Header="備考" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource NoteText}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" TextElement.FontSize="15" TextElement.FontWeight="Bold">
            <TextBlock Text="合計" Margin="0,0,20,0" />
            <TextBlock Text="{Binding Report.Count, StringFormat=回数 {0:0.##}, FallbackValue=回数 —}" Margin="0,0,20,0" />
            <TextBlock Text="{Binding Report.Expense, StringFormat=経費 {0:N0}, FallbackValue=経費 —}" Margin="0,0,20,0" />
            <TextBlock Text="{Binding Report.Profit, StringFormat=粗利 {0:N0}, FallbackValue=粗利 —}" Margin="0,0,20,0" />
            <TextBlock Text="{Binding Report.Net, StringFormat=営業利益 {0:N0}, FallbackValue=営業利益 —}" />
        </StackPanel>

        <!-- 集計中: ウィンドウ中央に表示（最前面・クリックは透過） -->
        <mah:ProgressRing Grid.RowSpan="4" IsActive="{Binding IsBusy}" Width="64" Height="64"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</mah:MetroWindow>


